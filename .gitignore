# Python bytecode and tool caches
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.ipynb_checkpoints/

# Local environments and build artifacts
.venv/
venv/
env/
build/
dist/
*.so
*.o
*.a

# Local credentials and machine-specific settings
.env
.env.*
!.env.example
.aws/
*.pem
*.key
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# External repositories, datasets, model weights, and generated outputs
# Keep directory placeholders; put tracked metadata/configurations elsewhere.
/thirdparty/*
!/thirdparty/.gitkeep
/data/*
!/data/.gitkeep
/checkpoints/*
!/checkpoints/.gitkeep
/results/*
!/results/.gitkeep
/logs/
/wandb/
/runs/
/outputs/

# Local paper PDFs and reference materials
/docs/papers/

# Large model / reconstruction artifacts, including accidental exports
*.pth
*.pt
*.ckpt
*.safetensors
*.onnx
*.ply

